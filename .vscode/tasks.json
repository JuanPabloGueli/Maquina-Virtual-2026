{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build VMX",
      "type": "shell",
      "command": "C:/msys64/ucrt64/bin/gcc.exe",
      "args": [
        "-g",
        "${workspaceFolder}/main.c",
        "${workspaceFolder}/operations.c",
        "-o",
        "${workspaceFolder}/vmx.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}